# Supabase Configuration (Settings → API) - NUEVO proyecto de Supabase, no el de rag-project
SUPABASE_URL=https://your-new-project-ref.supabase.co
SUPABASE_ANON_KEY=your_new_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_new_supabase_service_role_key_here
# Tabla y funciones que crea sql/init_supabase.sql (cada modelo de embeddings necesita su propia tabla)
RAG_TABLE=rag_chunks_ies
RAG_MATCH_FUNCTION=match_chunks_ies
RAG_STATS_FUNCTION=get_chunk_stats_ies

# NVIDIA API Catalog (crea tu clave en https://build.nvidia.com, botón "Get API Key")
NVIDIA_API_KEY=nvapi-tu_clave_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Modelo de chat que redacta las respuestas (lista en https://build.nvidia.com/models)
NVIDIA_MODEL=google/gemma-4-31b-it
# Modelos alternativos (separados por coma) si el principal falla o está saturado
NVIDIA_FALLBACK_MODELS=mistralai/mistral-large-2-instruct,nvidia/nemotron-3-super-120b-a12b

# Modelo de embeddings (nvidia/nemotron-3-embed-1b genera 2048 dimensiones)
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Debe coincidir con VECTOR(n) en sql/init_supabase.sql
EMBEDDING_DIMENSIONS=2048
# Tokens máximos por fragmento enviado al modelo de embeddings (los fragmentos se recortan para no pasarlo)
EMBED_MAX_TOKENS=512

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
